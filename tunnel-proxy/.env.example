# Environment variables for tunnel-proxy deployment
# Copy this to .env and fill in your values

# REQUIRED: Shared secret for client authentication (generate with: openssl rand -hex 32)
SHARED_SECRET=your-long-random-secret-here

# REQUIRED: Your wildcard domain (e.g., tunnel.example.com)
# This domain must have a wildcard DNS record (*.tunnel.example.com) pointing to your server
WILDCARD_DOMAIN=tunnel.example.com

# OPTIONAL: Server configuration (defaults shown, uncomment to override)
# HTTP_HOST=0.0.0.0
# HTTP_PORT=8080
# TCP_PORT_MIN=20000
# TCP_PORT_MAX=20100
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_PORT=8081
# HTTP_ONLY=true
# HEARTBEAT_INTERVAL=20
# HEARTBEAT_TIMEOUT=60
# STALE_GRACE_SECONDS=300
# DB_PATH=/data/tunnel_proxy.db
# LOG_LEVEL=INFO
# LOG_FILE=/var/log/tunnel-proxy/tunnel_proxy.log