# LinkPulse server environment template.
# Copy to .env and fill in real values. The server reads environment variables
# only: it does not read this file itself (Docker/--env-file or your shell does).
# Missing required values and leftover placeholder text fail startup.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Client authentication secret. Generate: openssl rand -hex 32
SHARED_SECRET=CHANGE_ME

# Apex domain for public URLs. Both <domain> and *.<domain> must resolve to
# this server. Example: tunnel.example.com
WILDCARD_DOMAIN=tunnel.example.com

# Dashboard login password and HS256 JWT signing secret. Both are validated at
# startup (even if you never open the dashboard). DASHBOARD_PASSWORD must be at
# least 8 characters, JWT_SECRET at least 32. Sessions are in-memory: a server
# restart, logout, or dashboard-password rotation invalidates them.
DASHBOARD_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME

# ---------------------------------------------------------------------------
# TLS / certificates
# ---------------------------------------------------------------------------

# Public HTTPS is terminated by the server using certbot (DNS challenge) in the
# container, or by you when EXTERNAL_SSL=true. Renewal is a separate cron job.
DNS_PROVIDER=cloudflare
CF_API_TOKEN=CHANGE_ME_cloudflare_api_token
CERTBOT_EMAIL=admin@example.com

# Set true to run without HTTPS/certificates (public URLs become http:// and
# the dashboard uses DASHBOARD_HOST:DASHBOARD_PORT).
HTTP_ONLY=false

# Set true when a reverse proxy terminates public TLS for you (skips certbot).
EXTERNAL_SSL=false

# Without a certificate the server fails startup. Set this true only to
# explicitly permit an HTTP-only run instead.
ALLOW_HTTP_FALLBACK=false

# Optional native TLS for the client control channel. Clients must use --tls
# and verify the certificate (system trust or --ca-cert); there is no
# skip-verify option. Without it, run clients over a private network/VPN.
CONTROL_TLS=false
# CONTROL_CERT_PATH=/etc/letsencrypt/live/tunnel.example.com/fullchain.pem
# CONTROL_KEY_PATH=/etc/letsencrypt/live/tunnel.example.com/privkey.pem

# Optional public certificate override (defaults follow WILDCARD_DOMAIN under
# /etc/letsencrypt/live/...).
# CERT_PATH=/etc/letsencrypt/live/tunnel.example.com/fullchain.pem
# KEY_PATH=/etc/letsencrypt/live/tunnel.example.com/privkey.pem

# ---------------------------------------------------------------------------
# Listeners and tunnel port pool
# ---------------------------------------------------------------------------

# CONTROL_HOST=0.0.0.0
# CONTROL_PORT=9000
# HTTP_HOST=0.0.0.0
# HTTP_PORT=80
# HTTPS_HOST=0.0.0.0
# HTTPS_PORT=443

# Raw TCP/UDP tunnel ports. Keep the pool small and publish exactly this range
# 1:1 (or use Docker host networking). Example: -p 20000-20100:20000-20100
# plus /udp when UDP tunnels are needed.
# TCP_PORT_MIN=20000
# TCP_PORT_MAX=20100
# UDP_PORT_MIN=20000
# UDP_PORT_MAX=20100

# Standalone dashboard listener. Only used when HTTPS is not active
# (HTTP_ONLY=true). Loopback by default.
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8081

# ---------------------------------------------------------------------------
# Storage and logging
# ---------------------------------------------------------------------------

# DB_PATH=/data/tunnel_proxy.db
# LOG_LEVEL=INFO
# LOG_FILE=/var/log/tunnel-proxy/tunnel_proxy.log

# ---------------------------------------------------------------------------
# Heartbeat, HTTP reconnect waiting, and resource limits
# ---------------------------------------------------------------------------

# HEARTBEAT_INTERVAL=20
# HEARTBEAT_TIMEOUT=60
# STALE_GRACE_SECONDS=300

# Park the request head and socket briefly when an HTTP tunnel's client has
# just dropped unexpectedly. No application-level body accumulation/spooling/
# replay; normal bounded TCP buffering applies. 0 disables waiting (404).
# HTTP_RECONNECT_GRACE_SECONDS=8
# HTTP_RECONNECT_MAX_WAITERS_PER_NAME=16
# HTTP_RECONNECT_MAX_WAITERS=128

# MAX_CLIENTS=128
# MAX_TUNNELS_PER_CLIENT=32
# MAX_STREAMS_PER_CLIENT=256
# MAX_PENDING_HTTP_CONNECTIONS=256
# UDP_MAX_PEERS_PER_TUNNEL=128
# UDP_IDLE_TIMEOUT=60
# STREAM_WRITE_TIMEOUT=30