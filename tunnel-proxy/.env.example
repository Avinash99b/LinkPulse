# Environment variables for tunnel-proxy deployment
# Copy this to .env and fill in your values

# REQUIRED: Shared secret for client authentication (generate with: openssl rand -hex 32)
SHARED_SECRET=your-long-random-secret-here

# REQUIRED: Your wildcard domain (e.g., linkpulse.avinash9.in)
# Both <domain> and *.<domain> must have DNS records pointing to your server
WILDCARD_DOMAIN=linkpulse.avinash9.in

# OPTIONAL: DNS provider credentials for certbot (auto-managed SSL).
# Required so the server can issue wildcard certs for <domain> and *.<domain>.
# At least ONE credential method must work or the server falls back to HTTP-only.
DNS_PROVIDER=cloudflare
CF_API_TOKEN=your-cloudflare-api-token
CERTBOT_EMAIL=admin@example.com

# OPTIONAL: Server configuration (defaults shown, uncomment to override)
# CONTROL_HOST=0.0.0.0
# CONTROL_PORT=9000
# HTTP_HOST=0.0.0.0
# HTTP_PORT=80
# HTTPS_HOST=0.0.0.0
# HTTPS_PORT=443
# TCP_PORT_MIN=10000
# TCP_PORT_MAX=65535
# UDP_PORT_MIN=10000
# UDP_PORT_MAX=65535
# CERT_PATH=/etc/letsencrypt/live/linkpulse.avinash9.in/fullchain.pem
# KEY_PATH=/etc/letsencrypt/live/linkpulse.avinash9.in/privkey.pem
# HTTP_ONLY=false
# HEARTBEAT_INTERVAL=20
# HEARTBEAT_TIMEOUT=60
# STALE_GRACE_SECONDS=300
# DB_PATH=/data/tunnel_proxy.db
# LOG_LEVEL=INFO
# LOG_FILE=/var/log/tunnel-proxy/tunnel_proxy.log
