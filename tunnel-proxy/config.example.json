{
  "shared_secret": "REPLACE_WITH_A_LONG_RANDOM_SECRET",

  "control": {
    "host": "0.0.0.0",
    "port": 9000,
    "tls": false
  },

  "http": {
    "host": "0.0.0.0",
    "port": 80
  },

  "https": {
    "host": "0.0.0.0",
    "port": 443
  },

  "wildcard_domain": "linkpulse.avinash9.in",

  "tcp": {
    "port_range": [10000, 65535],
    "bind_host": "0.0.0.0"
  },

  "udp": {
    "port_range": [10000, 65535],
    "bind_host": "0.0.0.0"
  },

  "tls": {
    "cert_path": "/etc/letsencrypt/live/linkpulse.avinash9.in/fullchain.pem",
    "key_path": "/etc/letsencrypt/live/linkpulse.avinash9.in/privkey.pem"
  },

  "dashboard": {
    "host": "0.0.0.0",
    "port": 8081
  },

  "http_only": false,

  "heartbeat_interval_seconds": 20,
  "heartbeat_timeout_seconds": 60,
  "stale_grace_seconds": 300,

  "storage": {
    "db_path": "/var/lib/tunnel-proxy/tunnel_proxy.db"
  },

  "logging": {
    "level": "INFO",
    "file": "/var/log/tunnel-proxy/tunnel_proxy.log"
  }
}